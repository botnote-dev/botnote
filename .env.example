# Copy to .env next to docker-compose.yml. Everything is optional for use on
# one machine; the "Networked" block is required once other devices connect.

# Image tag to run. Pin a release (for example 0.3.0) and change it to upgrade.
BOTNOTE_VERSION=latest

# ----- Networked: your own domain, several devices -----
# The address browsers and agents use. Setting it turns sign-in on: the first
# person to open it creates the owner account (email and password).
#BOTNOTE_PUBLIC_URL=https://notes.example.com
# Optional setup code. When set, creating the owner account asks for it, so a
# stranger who finds the address first cannot claim the instance.
#BOTNOTE_PASSWORD=
# Only for the bundled Caddy (`--profile caddy`): the host name to serve.
#BOTNOTE_DOMAIN=notes.example.com
# Set to cf-connecting-ip when Cloudflare sits in front of your proxy.
#BOTNOTE_CLIENT_IP_HEADER=x-forwarded-for

# ----- Database -----
# Password of the bundled Postgres. Letters and digits only: it is embedded in
# a connection URL. Set it before the first start; changing it later does not
# change the password stored in an existing data volume.
#POSTGRES_PASSWORD=
# Your own Postgres 16+ with pgvector, used with docker-compose.external-db.yml.
#DATABASE_URL=postgres://user:password@db.example.com:5432/botnote

# ----- Search -----
# Enables semantic search. Without it search is keyword-only (BM25).
#OPENAI_API_KEY=

# ----- Host port -----
# The daemon is published on 127.0.0.1 only. Put a reverse proxy in front
# rather than changing BOTNOTE_BIND to 0.0.0.0.
#BOTNOTE_BIND=127.0.0.1
#BOTNOTE_PORT=4280
